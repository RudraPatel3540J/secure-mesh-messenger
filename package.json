{
  "name": "secure-mesh-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Mesh Messenger — E2EE chat with cryptographic identity, live map, and privacy controls",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "server": "npm run dev --workspace=@smm/server",
    "mobile": "npm run start --workspace=@smm/mobile",
    "shared:build": "npm run build --workspace=@smm/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
